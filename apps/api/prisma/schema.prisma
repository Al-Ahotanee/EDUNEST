  reliefAsSubstitute ReliefAssignment[] @relation("ReliefStaffRelief")

  @@unique([schoolId, staffId])
  @@index([schoolId])
}

model Leave {
  id         String      @id @default(uuid())
  staffId    String
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String      @db.Text
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model Appraisal {
  id          String   @id @default(uuid())
  staffId     String
  period      String
  score       Float
  comments    String?  @db.Text
  conductedBy String
  createdAt   DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model Payroll {
  id          String        @id @default(uuid())
  schoolId    String
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items PayrollItem[]

  @@unique([schoolId, month, year])
}

model PayrollItem {
  id          String            @id @default(uuid())
  payrollId   String
  staffId     String
  basicSalary Float
  allowances  Float             @default(0)
  deductions  Float             @default(0)
  tax         Float             @default(0)
  netSalary   Float
  status      PayrollItemStatus @default(PENDING)

  payroll Payroll @relation(fields: [payrollId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@unique([payrollId, staffId])
  @@index([payrollId])
}

