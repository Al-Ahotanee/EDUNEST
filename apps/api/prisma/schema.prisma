generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── TENANT / SCHOOL ─────────────────────────────────────────────────────────

model Tenant {
  id                  String             @id @default(uuid())
  name                String
  slug                String             @unique
  domain              String?            @unique
  logo                String?            @db.LongText
  motto               String?
  address             String?
  city                String?
  state               String?
  lga                 String?
  phone               String?
  email               String?
  website             String?
  yearEstablished     Int?
  primaryColor        String             @default("#1a56db")
  secondaryColor      String             @default("#7e3af2")
  subscriptionPlan    SubscriptionPlan   @default(BASIC)
  subscriptionStatus  SubscriptionStatus @default(PENDING_APPROVAL)
  subscriptionExpiry  DateTime?
  isActive            Boolean            @default(false)
  // Documents
  ministryApprovalDoc String?
  cacDocument         String?
  proofOfAddress      String?
  otherDocuments      String?
  // Marketer
  marketerId          String?
  referralCode        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  schools         School[]
  users           User[]
  roles           Role[]
  auditLogs       AuditLog[]
  marketer        Marketer?              @relation(fields: [marketerId], references: [id])
  // ─── Phase 2: Financial module relation ──────────────────────────────────
  financialPolicy TenantFinancialPolicy?
}

model School {
  id                 String     @id @default(uuid())
  tenantId           String
  name               String
  code               String
  type               SchoolType
  address            String?
  phone              String?
  email              String?
  logo               String?            @db.LongText
  motto              String?
  website            String?
  principalSignature String?            @db.LongText
  stampSeal          String?            @db.LongText
  isActive           Boolean    @default(true)
  // P0 fix: persist timetable publish state so it survives reloads.
  // When false, the timetable is "Draft" and not visible on Student/Parent portals.
  timetablePublished Boolean    @default(true)
  // P2 fix: stores the academic session id that's currently active for timetabling.
  // Used by Academic Dates CRUD so admins can scope events to a session.
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  users              User[]
  students           Student[]
  staff              Staff[]
  classes            Class[]
  sessions           AcademicSession[]
  departments        Department[]
  feeStructures      FeeStructure[]
  hostels            Hostel[]
  buses              Bus[]
  teacherAssignments TeacherAssignment[]
  termReportCards    TermReportCard[]
  gradingScales      GradingScale[]
  reliefAssignments  ReliefAssignment[]
  academicEvents     AcademicEvent[]
  // ─── Phase 2: Financial module relations ──────────────────────────────────
  receipts           Receipt[]
  creditNotes        CreditNote[]
  financialAuditLogs FinancialAuditLog[]
  // ─── White-Label & Website CMS relations ──────────────────────────────────
  websiteConfig      SchoolWebsiteConfig?
  inquiries          SchoolInquiry[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─── SCHOOL WEBSITE CMS & INQUIRIES ──────────────────────────────────────────

model SchoolWebsiteConfig {
  id               String    @id @default(uuid())
  schoolId         String    @unique
  template         String    @default("MODERN_ACADEMY") // MODERN_ACADEMY, CLASSIC_HERITAGE, VIBRANT_CAMPUS, MINIMAL_EXCELLENCE, COMPREHENSIVE_COMMUNITY
  isPublished      Boolean   @default(true)
  publishedAt      DateTime? @default(now())
  draftContent     Json?
  publishedContent Json?
  metaTitle        String?
  metaDescription  String?   @db.Text
  ogImage          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolInquiry {
  id         String   @id @default(uuid())
  schoolId   String
  name       String
  email      String
  phone      String?
  subject    String?
  message    String   @db.Text
  status     String   @default("NEW") // NEW, CONTACTED, CLOSED
  adminNotes String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
}

/// Academic calendar event — milestones like resumption, CA weeks, exams,
/// holidays, vacations. Surfaced in the Timetable > Academic Dates view
/// (P2 fix: previously hard-coded; now persisted via CRUD endpoints).
model AcademicEvent {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  type        String    @default("ACADEMIC") // ACADEMIC | EXAMINATION | HOLIDAY | VACATION | EVENT
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([startDate])
}

// ─── USERS & AUTH ─────────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(uuid())
  tenantId               String?
  schoolId               String?
  email                  String
  password               String
  firstName              String
  lastName               String
  phone                  String?
  avatar                 String?
  isActive               Boolean   @default(true)
  isSuperAdmin           Boolean   @default(false)
  isMarketer             Boolean   @default(false)
  marketerId             String?
  isEmailVerified        Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpiry    DateTime?
  lastLoginAt            DateTime?
  lastLoginIp            String?
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  school              School?              @relation(fields: [schoolId], references: [id])
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  loginHistory        LoginHistory[]
  teacherAssignments  TeacherAssignment[]
  // ─── Phase 2: Financial module relations ──────────────────────────────────
  parentStudentLinks  ParentStudentLink[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([schoolId])
  @@index([isSuperAdmin])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Password reset token issued by /auth/forgot-password and consumed by
/// /auth/reset-password. Single-use, expires after 30 minutes.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── ROLES & PERMISSIONS ──────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String  @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ─── MARKETER ─────────────────────────────────────────────────────────────────

model Marketer {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String?
  password       String
  referralCode   String   @unique
  commissionRate Float    @default(5.0)
  totalReferrals Int      @default(0)
  totalEarnings  Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referredTenants Tenant[]
}

// ─── STUDENTS ─────────────────────────────────────────────────────────────────

model Student {
  id               String        @id @default(uuid())
  schoolId         String
  admissionNumber  String
  firstName        String
  lastName         String
  otherName        String?
  gender           Gender
  dateOfBirth      DateTime
  bloodGroup       String?
  genotype         String?
  stateOfOrigin    String?
  lga              String?
  religion         String?
  tribe            String?
  nationality      String        @default("Nigerian")
  address          String?
  photo            String?       @db.LongText
  birthCertificate String?       @db.LongText
  immunizationCard String?       @db.LongText
  previousSchool   String?
  previousClass    String?
  status           StudentStatus @default(ACTIVE)
  admissionDate    DateTime      @default(now())
  graduationDate   DateTime?
  medicalCondition String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  school              School               @relation(fields: [schoolId], references: [id])
  guardians           Guardian[]
  classEnrollments    ClassEnrollment[]
  attendances         Attendance[]
  results             Result[]
  invoices            Invoice[]
  healthRecords       HealthRecord[]
  hostelAllocations   HostelAllocation[]
  admissions          Admission[]
  disciplinaryRecords DisciplinaryRecord[]
  documents           Document[]
  examAttempts        ExamAttempt[]
  termReportCards     TermReportCard[]
  // ─── Phase 2: Financial module relations ──────────────────────────────────
  creditNotes         CreditNote[]
  parentLinks         ParentStudentLink[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model Guardian {
  id            String   @id @default(uuid())
  studentId     String
  firstName     String
  lastName      String
  relationship  String
  phone         String
  email         String?
  address       String?
  occupation    String?
  officeAddress String?
  isEmergency   Boolean  @default(false)
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Admission {
  id               String          @id @default(uuid())
  schoolId         String
  studentId        String?
  applicationNo    String
  firstName        String
  lastName         String
  otherName        String?
  gender           Gender
  dateOfBirth      DateTime
  email            String?
  phone            String?
  parentName       String
  parentPhone      String
  parentEmail      String?
  parentOccupation String?
  applyingForClass String
  boardingDay      String?
  status           AdmissionStatus @default(PENDING)
  stage            String          @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, EXAM_SCHEDULED, INTERVIEW_SCHEDULED, APPROVED, REJECTED, ENROLLED
  examScore        Float?
  examDate         DateTime?
  interviewDate    DateTime?
  rejectionReason  String?         @db.Text
  notes            String?
  admittedAt       DateTime?
  photo            String?         @db.LongText
  birthCertificate String?         @db.LongText
  lastReportCard   String?         @db.LongText
  stateOfOrigin    String?
  religion         String?
  bloodGroup       String?
  medicalCondition String?
  previousSchool   String?
  emergencyContact String?
  emergencyPhone   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  student Student? @relation(fields: [studentId], references: [id])

  @@unique([schoolId, applicationNo])
  @@index([schoolId])
}

// ─── ACADEMIC ─────────────────────────────────────────────────────────────────

model AcademicSession {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School            @relation(fields: [schoolId], references: [id])
  terms            Term[]
  classEnrollments ClassEnrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id        String   @id @default(uuid())
  sessionId String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session         AcademicSession  @relation(fields: [sessionId], references: [id])
  attendances     Attendance[]
  results         Result[]
  examinations    Examination[]
  termReportCards TermReportCard[]

  @@unique([sessionId, name])
  @@index([sessionId])
}

model Class {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  level     Int
  section   String?
  capacity  Int      @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  classEnrollments   ClassEnrollment[]
  timetableSlots     TimetableSlot[]
  teacherAssignments TeacherAssignment[]
  termReportCards    TermReportCard[]
  reliefAssignments  ReliefAssignment[]
  feeStructures      FeeStructure[]

  @@unique([schoolId, name, section])
  @@index([schoolId])
}

model ClassEnrollment {
  id         String   @id @default(uuid())
  studentId  String
  classId    String
  sessionId  String
  isPromoted Boolean  @default(false)
  createdAt  DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id])
  class   Class           @relation(fields: [classId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])
  @@index([classId])
  @@index([sessionId])
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  code        String
  description String?
  isCore      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetableSlots     TimetableSlot[]
  results            Result[]
  reliefAssignments  ReliefAssignment[]
  questions          Question[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, code])
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  classId   String?
  termId    String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  isSynced  Boolean          @default(true)

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@index([termId])
  @@index([date])
}

// ─── RESULTS ──────────────────────────────────────────────────────────────────

model Result {
  id          String       @id @default(uuid())
  studentId   String
  subjectId   String
  termId      String
  ca1Score    Float?       @default(0)
  ca2Score    Float?       @default(0)
  ca3Score    Float?       @default(0)
  examScore   Float?       @default(0)
  totalScore  Float?       @default(0)
  grade       String?
  position    Int?
  remark      String?
  status      ResultStatus @default(DRAFT)
  isApproved  Boolean      @default(false)
  submittedBy String?
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isSynced    Boolean      @default(true)

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@index([studentId])
  @@index([termId])
  @@index([status])
}

model TeacherAssignment {
  id        String          @id @default(uuid())
  schoolId  String
  userId    String
  classId   String
  subjectId String?
  roleType  TeacherRoleType @default(SUBJECT_TEACHER)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, classId, subjectId])
  @@index([schoolId])
  @@index([userId])
  @@index([classId])
}

model TermReportCard {
  id                    String       @id @default(uuid())
  schoolId              String
  studentId             String
  termId                String
  classId               String
  attendanceDaysTotal   Int          @default(0)
  attendanceDaysPresent Int          @default(0)
  attendanceDaysAbsent  Int          @default(0)
  classTeacherRemark    String?      @db.Text
  principalRemark       String?      @db.Text
  nextTermResumption    DateTime?
  promotionStatus       String?
  affectiveRatings      Json?
  psychomotorRatings    Json?
  totalScore            Float?       @default(0)
  averageScore          Float?       @default(0)
  position              Int?
  classSize             Int?
  status                ResultStatus @default(DRAFT)
  submittedBy           String?
  submittedAt           DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  publishedBy           String?
  publishedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([classId, termId])
  @@index([status])
}

model GradingScale {
  id         String   @id @default(uuid())
  schoolId   String
  name       String   @default("Default")
  minScore   Float
  maxScore   Float
  grade      String
  gradePoint Float?
  remark     String
  isPass     Boolean  @default(true)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// ─── CBT EXAMINATIONS ─────────────────────────────────────────────────────────

model Examination {
  id           String   @id @default(uuid())
  termId       String
  title        String
  description  String?
  duration     Int
  totalMarks   Int
  passMark     Int
  startTime    DateTime
  endTime      DateTime
  isPublished  Boolean  @default(false)
  isRandomized Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  term      Term          @relation(fields: [termId], references: [id])
  questions Question[]
  attempts  ExamAttempt[]

  @@index([termId])
}

model Question {
  id            String       @id @default(uuid())
  examinationId String
  subjectId     String
  type          QuestionType
  content       String       @db.Text
  options       Json?
  answer        String
  explanation   String?      @db.Text
  marks         Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  examination Examination    @relation(fields: [examinationId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])
  responses   ExamResponse[]

  @@index([examinationId])
}

model ExamAttempt {
  id            String        @id @default(uuid())
  examinationId String
  studentId     String
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  score         Float?
  isPassed      Boolean?
  timeSpent     Int?
  status        AttemptStatus @default(IN_PROGRESS)

  examination Examination    @relation(fields: [examinationId], references: [id])
  student     Student        @relation(fields: [studentId], references: [id])
  responses   ExamResponse[]

  @@unique([examinationId, studentId])
  @@index([examinationId])
  @@index([studentId])
}

model ExamResponse {
  id          String   @id @default(uuid())
  attemptId   String
  questionId  String
  answer      String?
  isCorrect   Boolean?
  marksEarned Float?

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

// ─── FINANCE ──────────────────────────────────────────────────────────────────

model FeeStructure {
  id          String  @id @default(uuid())
  schoolId    String
  name        String
  amount      Float
  description String?
  termBased   Boolean @default(true)
  // ─── Round 6 enhancements: class-scoped, session/term-scoped fee schedules ──
  classId     String? // if set, this fee structure applies only to this class
  sessionId   String? // if set, applies only to this academic session
  termId      String? // if set, applies only to this term
  feeType     String  @default("TERM") // ONE_TIME | ANNUAL | TERM
  status      String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  applicableTo String @default("ALL") // ALL | NEW_STUDENT | RETURNING_STUDENT
  isCompulsory Boolean @default(true)
  category    String? // TUITION | APPLICATION | ADMISSION | UNIFORM | BOOKS | LAB | EXAM | PTA | OTHER
  dueDate     DateTime?

  // ─── Phase 2: Approval workflow tracking ──────────────────────────────────
  createdById   String? // User who created the fee structure
  publishedById String? // User who published it
  publishedAt   DateTime?
  archivedAt    DateTime?
  version       Int       @default(1) // increments on each publish

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id])
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  invoiceItems InvoiceItem[]

  @@index([schoolId])
  @@index([classId])
}

model Invoice {
  id         String        @id @default(uuid())
  studentId  String
  invoiceNo  String        @unique
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  subtotal   Float
  discount   Float         @default(0)
  total      Float
  amountPaid Float         @default(0)
  balance    Float
  status     InvoiceStatus @default(UNPAID)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // ─── Phase 2: Academic scoping for proper invoice filtering ────────────────
  schoolId  String? // tenant school that issued the invoice
  sessionId String? // academic session
  termId    String? // academic term
  classId   String? // student's class at time of issuance

  // ─── Phase 2: Workflow tracking ───────────────────────────────────────────
  generatedById      String? // User who generated the invoice
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  student     Student             @relation(fields: [studentId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@index([studentId])
  @@index([schoolId])
  @@index([sessionId])
  @@index([termId])
  @@index([classId])
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String
  feeStructureId String?
  description    String
  amount         Float
  quantity       Int     @default(1)
  subtotal       Float

  invoice      Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure?       @relation(fields: [feeStructureId], references: [id])
  allocations  PaymentAllocation[]

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  amount      Float
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  reference   String?
  receiptNo   String        @unique
  notes       String?
  createdAt   DateTime      @default(now())
  isSynced    Boolean       @default(true)

  // ─── Phase 2: Financial module enhancements ──────────────────────────────
  // Payment status state machine — tracks lifecycle from submission to posting
  status PaymentStatus @default(POSTED) // default POSTED for backward compat

  // Workflow tracking — who recorded, verified, approved, posted
  recordedById    String? // User who recorded/submitted the payment
  verifiedById    String? // School Accountant who verified
  approvedById    String? // School Accountant who approved (for Class Master submissions)
  verifiedAt      DateTime?
  approvedAt      DateTime?
  postedAt        DateTime? // when the payment was officially posted
  rejectionReason String? // required if status = REJECTED

  // Class Master cash submission context
  isClassMasterSubmission Boolean @default(false)
  submissionNotes         String?

  // Reversal tracking
  reversedAt          DateTime?
  reversedById        String?
  reversalReason      String?
  reversedByPaymentId String? // links to the compensating payment if reversed

  // Idempotency — prevent duplicate submissions from retries
  idempotencyKey String? @unique

  invoice     Invoice             @relation(fields: [invoiceId], references: [id])
  allocations PaymentAllocation[]
  receipt     Receipt?
  creditNotes CreditNote[]

  @@index([invoiceId])
  @@index([status])
  @@index([recordedById])
  @@index([verifiedById])
}

/// Payment status state machine. Tracks the lifecycle of a payment from
/// initiation through verification, approval, posting, and potential reversal.
/// This is separate from InvoiceStatus so a payment can be "PENDING_APPROVAL"
/// while the invoice remains "UNPAID" — the invoice balance only decreases
/// when the payment reaches POSTED status.
enum PaymentStatus {
  INITIATED // Payment initiated but not yet submitted
  PENDING_VERIFICATION // Awaiting verification (e.g. bank transfer screenshot)
  PENDING_ACCOUNTANT_APPROVAL // Class Master cash submission awaiting Accountant approval
  VERIFIED // Verified by School Accountant, awaiting posting
  POSTED // Officially posted — reduces invoice balance
  FAILED // Failed (e.g. gateway declined)
  REJECTED // Rejected by School Accountant
  REVERSED // Reversed after posting (compensating entry)
  REFUNDED // Refunded to payer
}

/// Tenant-level financial policy. Controls school-wide financial behavior
/// including Class Master collection permissions and approval thresholds.
/// One record per tenant (school). Created on first access if missing.
model TenantFinancialPolicy {
  id       String @id @default(uuid())
  tenantId String @unique

  // Class Master collection mode:
  //   VIEW_ONLY        — Class Masters can only view, cannot record payments
  //   RECORD_PENDING   — Class Masters can record cash payments, Accountant must approve
  classMasterCollectionMode String @default("VIEW_ONLY")

  // Whether Class Masters can issue provisional acknowledgements (not official receipts)
  allowProvisionalAcknowledgement Boolean @default(false)

  // Whether online payments (Paystack) are enabled for this tenant
  onlinePaymentsEnabled Boolean @default(false)

  // Whether parents can submit bank transfer references for manual verification
  allowTransferReferenceSubmission Boolean @default(true)

  // Default payment due date offset (days from invoice issue)
  defaultDueDateDays Int @default(30)

  // Overdue threshold (days past due date before marking OVERDUE)
  overdueThresholdDays Int @default(7)

  // Whether refunds require Principal approval
  refundsRequirePrincipalApproval Boolean @default(true)

  // Maximum cash payment a Class Master can record without escalation (0 = no limit)
  classMasterCashLimit Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Payment allocation — links a payment to specific invoice items.
/// Supports partial payments, multi-invoice allocation, and overpayment tracking.
/// A single Payment can have multiple PaymentAllocation records (one per invoice item paid).
model PaymentAllocation {
  id            String   @id @default(uuid())
  paymentId     String
  invoiceId     String
  invoiceItemId String? // optional — if null, allocation is to the invoice generally
  amount        Float // amount allocated to this invoice/item
  createdAt     DateTime @default(now())

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([invoiceId])
  @@index([invoiceItemId])
}

/// Official receipt record. Generated when a payment reaches POSTED status.
/// One receipt per posted payment. Reprints tracked via reprintCount.
model Receipt {
  id        String @id @default(uuid())
  receiptNo String @unique
  paymentId String @unique // one receipt per payment
  schoolId  String

  // Receipt content (snapshot at time of issuance)
  studentName        String
  studentAdmissionNo String
  className          String?
  payerName          String?
  amountInFigures    Float
  amountInWords      String
  paymentDate        DateTime
  paymentMethod      String
  transactionRef     String?
  sessionId          String?
  termId             String?
  invoiceAllocations String? // JSON summary of which invoices were paid

  issuedById        String // User who issued/authorized the receipt
  issuedAt          DateTime  @default(now())
  reprintCount      Int       @default(0)
  lastReprintedAt   DateTime?
  lastReprintedById String?

  // Cancellation support
  isCancelled        Boolean   @default(false)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([paymentId])
}

/// Credit note — for refunds, waivers, discounts, and adjustments.
/// Each credit note has an approval workflow and links to the original
/// invoice/payment being adjusted.
enum CreditNoteType {
  DISCOUNT // Approved discount on an invoice
  WAIVER // Fee waiver (full or partial)
  REFUND // Refund to payer
  ADJUSTMENT // Manual adjustment (debit or credit)
  REVERSAL // Reversal of a posted payment
}

enum CreditNoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

model CreditNote {
  id           String           @id @default(uuid())
  schoolId     String
  creditNoteNo String           @unique
  type         CreditNoteType
  status       CreditNoteStatus @default(DRAFT)

  // What is being credited
  invoiceId String? // invoice being adjusted
  paymentId String? // payment being reversed/refunded
  studentId String

  // Financial details
  amount      Float // positive = credit to student, negative = debit
  reason      String
  description String?

  // Approval workflow
  requestedById   String // User who requested
  approvedById    String? // User who approved (null if pending)
  approvedAt      DateTime?
  rejectionReason String?

  // Posting
  postedAt   DateTime?
  postedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([invoiceId])
}

/// Append-only audit log for all financial actions. Every sensitive
/// financial operation writes a record here. Never updated or deleted.
enum FinancialAction {
  FEE_STRUCTURE_CREATED
  FEE_STRUCTURE_PUBLISHED
  FEE_STRUCTURE_ARCHIVED
  INVOICE_GENERATED
  INVOICE_CANCELLED
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_POSTED
  PAYMENT_REVERSED
  PAYMENT_REFUNDED
  RECEIPT_ISSUED
  RECEIPT_REPRINTED
  RECEIPT_CANCELLED
  CREDIT_NOTE_CREATED
  CREDIT_NOTE_APPROVED
  CREDIT_NOTE_POSTED
  ALLOCATION_ADJUSTED
  POLICY_UPDATED
}

model FinancialAuditLog {
  id          String          @id @default(uuid())
  schoolId    String
  action      FinancialAction
  entityType  String // 'Invoice' | 'Payment' | 'FeeStructure' | 'Receipt' | 'CreditNote'
  entityId    String // ID of the affected entity
  userId      String? // User who performed the action
  userRole    String? // Role at time of action
  ipAddress   String?
  userAgent   String?
  description String // human-readable summary
  metadata    String? // JSON string with before/after values
  createdAt   DateTime        @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

/// Explicit link between a User account (parent/guardian) and Student records.
/// This is the source of truth for parent→child access — never trust URL params.
/// A parent can be linked to multiple students; a student can have multiple
/// linked parent users.
model ParentStudentLink {
  id           String   @id @default(uuid())
  userId       String // User account (parent/guardian)
  studentId    String // Student record
  relationship String? // 'father' | 'mother' | 'guardian' | etc.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([userId, studentId]) // prevent duplicate links
  @@index([userId])
  @@index([studentId])
}

// ─── HR & STAFF ───────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  description String?
  headId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id])
  staff  Staff[]

  @@unique([schoolId, name])
}

model Staff {
  id             String         @id @default(uuid())
  schoolId       String
  userId         String?
  staffId        String
  firstName      String
  lastName       String
  gender         Gender
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  photo          String?        @db.LongText
  departmentId   String?
  designation    String?
  employmentType EmploymentType @default(FULL_TIME)
  employmentDate DateTime?
  salary         Float?
  bankName       String?
  accountNumber  String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  school             School             @relation(fields: [schoolId], references: [id])
  department         Department?        @relation(fields: [departmentId], references: [id])
  leaves             Leave[]
  appraisals         Appraisal[]
  payrollItems       PayrollItem[]
  timetableSlots     TimetableSlot[]
