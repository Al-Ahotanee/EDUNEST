# ─── EduNest API Environment Configuration ─────────────────────────────────────

# Cloud Database (Aiven MySQL Managed Service)
# Format for Aiven: mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
DATABASE_URL="mysql://avnadmin:your_password@mysql-xxxxx-project.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# Security & Tokens
JWT_SECRET="generate-a-secure-random-64-char-secret-key-for-edunest"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server & Network
PORT=10000
NODE_ENV=production
FRONTEND_URL="https://edunest.onrender.com"

# Root SuperAdmin Initial Seed
SUPER_ADMIN_EMAIL="admin@schoolerp.com"
SUPER_ADMIN_PASSWORD="password123"

# Payment Gateways (Paystack Nigeria)
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret"
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public"

# File Storage
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760
