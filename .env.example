# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://erp_user:erp_password@localhost:3306/school_erp"
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=school_erp
MYSQL_USER=erp_user
MYSQL_PASSWORD=erp_password_change_me

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_password@localhost:6379
REDIS_PASSWORD=redis_password_change_me

# ─── File Storage (MinIO / S3) ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=school-erp
MINIO_USE_SSL=false

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SchoolOS <noreply@school.edu.ng>

# ─── SMS ─────────────────────────────────────────────────────────────────────
SMS_PROVIDER=termii
SMS_API_KEY=your-termii-api-key
SMS_SENDER_ID=SchoolOS

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=SchoolOS
APP_URL=http://localhost:5173
